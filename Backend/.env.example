# ============================================
# Backend API — Variables de Entorno
# Copiar como .env y completar los valores
# ============================================

# Puerto del servidor
PORT=3000

# MongoDB (Atlas M0 gratis o local)
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/eco_nodo?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/eco_nodo
MONGO_URI=mongodb://localhost:27017/eco_nodo

# JWT — access token (15 minutos)
JWT_SECRET=cambiar_por_secreto_muy_largo_y_aleatorio_minimo_32_chars
JWT_EXPIRES_IN=15m

# JWT — refresh token (7 días, DIFERENTE al JWT_SECRET)
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_diferente_minimo_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Clave interna para llamadas de n8n → Backend (sin JWT)
# Debe coincidir con BACKEND_INTERNAL_KEY en docker-compose
INTERNAL_API_KEY=cambiar_por_clave_interna_segura

# Entorno
NODE_ENV=development

# DigitalOcean Spaces (S3-compatible) — para imágenes de productos y PDFs
# Dev: puedes usar MinIO local (ver docs/setup/LOCAL_DEV.md) o dejarlo vacío
# Prod: crear bucket en DigitalOcean Spaces → https://cloud.digitalocean.com/spaces
DO_SPACES_KEY=tu_do_spaces_key
DO_SPACES_SECRET=tu_do_spaces_secret
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=nombre_bucket
DO_SPACES_CDN_URL=https://nombre_bucket.nyc3.cdn.digitaloceanspaces.com

# Evolution API (WhatsApp) — servidor donde corre Evolution API
# Dev: http://localhost:8080 (Docker local)
# Prod: URL pública del servidor
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=superapikey

# URL interna de Evolution API para que n8n la alcance dentro de Docker
EVOLUTION_API_URL_INTERNAL=http://eco_evolution:8080

# URL del webhook de n8n que Evolution API llamará al recibir mensajes
# Dev: usar ngrok para exponer localhost (ver docs/setup/LOCAL_DEV.md)
# Prod: https://n8n.tudominio.com/webhook/whatsapp-inbound
N8N_WEBHOOK_URL=http://eco_n8n:5678/webhook/whatsapp-inbound

# MercadoPago (pagos) — opcional en dev
# Obtener en: https://www.mercadopago.com.co/developers/panel
# Usar credenciales de SANDBOX para desarrollo
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_sandbox

# Email SMTP — opcional en dev (si no se configura, se imprime en consola)
# Dev gratis: usar Ethereal → https://ethereal.email/create
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=tu_usuario_ethereal
SMTP_PASS=tu_password_ethereal
SMTP_FROM=noreply@tuapp.com

# Google OAuth (agenda/sheets/drive) — opcional en dev
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_ENCRYPTION_KEY=clave_32_chars_para_cifrar_tokens

# URL del frontend (CORS en producción)
FRONTEND_URL=http://localhost:5173
